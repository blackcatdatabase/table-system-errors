{
  "tables": {
    "system_errors": {
      "columns": {
        "context": {
          "strategy": "passthrough"
        },
        "created_at": {
          "strategy": "passthrough"
        },
        "exception_class": {
          "strategy": "passthrough"
        },
        "file": {
          "strategy": "passthrough"
        },
        "fingerprint": {
          "strategy": "passthrough"
        },
        "http_status": {
          "strategy": "passthrough"
        },
        "id": {
          "strategy": "passthrough"
        },
        "ip_hash": {
          "context": "db.hmac.system_errors.ip_hash",
          "key_version_column": "ip_hash_key_version",
          "strategy": "hmac",
          "write_key_version": true
        },
        "ip_hash_key_version": {
          "strategy": "passthrough"
        },
        "last_seen": {
          "strategy": "passthrough"
        },
        "level": {
          "strategy": "passthrough"
        },
        "line": {
          "strategy": "passthrough"
        },
        "message": {
          "strategy": "passthrough"
        },
        "method": {
          "strategy": "passthrough"
        },
        "occurrences": {
          "strategy": "passthrough"
        },
        "resolved": {
          "strategy": "passthrough"
        },
        "resolved_at": {
          "strategy": "passthrough"
        },
        "resolved_by": {
          "strategy": "passthrough"
        },
        "stack_trace": {
          "strategy": "passthrough"
        },
        "token": {
          "strategy": "passthrough"
        },
        "url": {
          "strategy": "passthrough"
        },
        "user_agent": {
          "strategy": "passthrough"
        },
        "user_id": {
          "strategy": "passthrough"
        }
      }
    }
  }
}